# ==============================================================
# .env — /themis-aws-deploy  ·  ASA (Active-Standby) Architecture
# ==============================================================
# 17 VMs: Dual-site Active/Standby
#   redis01, redis02, redis03   — primary site Redis Sentinel
#   redis04, redis05, redis06   — secondary site Redis Sentinel
#   mongo01, mongo02, mongo03, mongo04  — MongoDB ReplicaSet members (cross-site)
#   mongo05                     — MongoDB arbiter
#   platform01, platform02      — IAP Platform (primary site)
#   platform03, platform04      — IAP Platform (secondary site)
#   gateway01                   — IAG Gateway (primary site)
#   gateway02                   — IAG Gateway (secondary site)
#
# Build time: ~68 min  |  Est. cost: ~$1.60–1.80/hr
#
# USAGE:
#   cp sample-env/env.asa.example .env
#   # Fill in all fields marked REQUIRED
#   # Then open run-vars.yml and set:  architecture: asa
#   # Then invoke: /themis-aws-deploy
#
# ASA CRITICAL NOTES:
#   !! INSTANCE NAMES ARE FLAT (redis01–06, NOT dc1-redis01 etc.) !!
#      Current Themis main uses flat sequential naming for ASA.
#      The file tfvars-overrides/asa-with-gateway.tfvars uses OLD dc1-/dc2-/dc3-
#      naming — NEVER apply it. It will destroy running instances by replacing
#      them with wrongly-named ones. DEPLOY_GATEWAY_TFVARS must NOT be set for ASA.
#
#   - Security Group self-referencing all-traffic rule is MANDATORY.
#     Cross-site replication requires MongoDB (27017), Redis (6379/26379),
#     etcd (2379/2380), IAP (3000), and IAG (8083) to reach across VMs.
#
#   - Subnets: use 3 distinct subnets across AZs. ASA places:
#       primary site nodes   → public-1a and public-1b
#       secondary site nodes → public-1c
#     All 3 keys are always required in the subnet_map block.
#
#   - After build verification:
#       tofu output -json | jq '.instances.value | keys'    # confirm flat names
#       mongo --eval "rs.status().members"                  # confirm all 5 members
#       redis-cli -h redis01 sentinel masters               # confirm master elected
# ==============================================================

# ── JFrog Identity Token (REQUIRED) ──────────────────────────
JFROG_TOKEN=

# ── GitLab Deploy Token (Required on first sync or after team update) ─
GITLAB_TOKEN=

# ── AWS Account (REQUIRED for non-pe-team-sbx accounts) ─────

AWS_REGION=us-east-1

# EC2 key pair name in the target account
AWS_KEY_NAME=your-ec2-key-pair-name

# Security Group — self-referencing all-traffic rule is MANDATORY for ASA
# Cross-site replication (MongoDB, Redis) and IAP cluster comms require it.
# See the AWS Account Setup section in the Admin Guide for creation commands.
AWS_SECURITY_GROUP_IDS=sg-xxxxxxxxxxxx

# 3 subnets REQUIRED — ASA places nodes across two sites using all 3 AZs
#   public-1a (subnet-aaa) → primary site nodes (redis01-03, mongo01-02, platform01-02, gateway01)
#   public-1b (subnet-bbb) → additional primary site nodes
#   public-1c (subnet-ccc) → secondary site nodes (redis04-06, mongo03-05, platform03-04, gateway02)
# Find your subnets:
#   aws ec2 describe-subnets --filters "Name=default-for-az,Values=true" \
#     --query 'Subnets[].{ID:SubnetId,AZ:AvailabilityZone}' --output table
AWS_SUBNET_IDS=subnet-aaa111111,subnet-bbb222222,subnet-ccc333333
AWS_DEFAULT_SUBNET=public-1a

# ── Instance Sizing (ASA — 17 VMs, production-grade) ──────────
# ASA is the largest topology — size up for real workloads.
# MongoDB stores cross-site data; Platform handles dual-site traffic.
AWS_INSTANCE_TYPE_PLATFORM=t3.xlarge    # Platform ×4 (primary + secondary site) — more traffic in ASA
AWS_INSTANCE_TYPE_REDIS=t3.medium       # Redis ×6 (3 per site) — medium is adequate for sentinel
AWS_INSTANCE_TYPE_MONGODB=t3.large      # MongoDB ×5 (cross-site RS, more data volume)
AWS_INSTANCE_TYPE_GATEWAY=t3.medium     # Gateway ×2 (gateway01 + gateway02)

# ── CRITICAL: DO NOT set for ASA ─────────────────────────────
# asa-with-gateway.tfvars uses OLD dc1-/dc2-/dc3- naming — it will destroy
# running instances by replacing them with wrongly-named ones.
# NEVER uncomment this for ASA:
# DEPLOY_GATEWAY_TFVARS=true
