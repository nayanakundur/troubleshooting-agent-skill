# ============================================================
# .env — /themis-aws-deploy  ·  AIO (All-in-One) Architecture
# ============================================================
# 1 VM: IAP Platform, IAG, MongoDB, Redis all colocated on one instance
# Build time: ~45–70 min  |  Est. cost: ~$0.15–0.20/hr
#
# USAGE:
#   cp sample-env/env.aio.example .env
#   # Fill in all fields marked REQUIRED
#   # Then open run-vars.yml and set:  architecture: aio
#   # Then invoke: /themis-aws-deploy
#
# NOTES:
#   - All services share one VM — use t3.xlarge minimum for headroom
#   - Only AWS_INSTANCE_TYPE_PLATFORM applies; Redis/MongoDB/Gateway types
#     are ignored for AIO since there are no separate role VMs
#   - 3 subnet IDs are always required in the subnet_map block even though
#     AIO only uses the first (public-1a)
# ============================================================

# ── JFrog Identity Token (REQUIRED) ──────────────────────────
# Per-engineer token — not shared. Generate at:
#   itential.jfrog.io → User Profile → Generate Identity Token
# Used to: pull platform RPMs (repository_password auto-populate) and
# optionally pull the IAG .whl if gateway_release is set in run-vars.yml
JFROG_TOKEN=

# ── GitLab Deploy Token (Required on first sync or after team update) ─
# Shared token — obtain from 1Password or Vault.
# Used to: sync platform-skills (sync-platform-skills.sh) from private GitLab.
# Leave blank if you have already synced and the skill files are current.
GITLAB_TOKEN=

# ── AWS Account (REQUIRED for non-pe-team-sbx accounts) ─────
# Leave all AWS_ fields blank if you are on the pe-team-sbx profile —
# Themis terraform.tfvars defaults (us-east-1, pe-team-sbx key pair, etc.) apply.
# Fill in if you are on a personal or customer sandbox AWS account.

# AWS region (default: us-east-1)
AWS_REGION=us-east-1

# Name of an existing EC2 key pair in the target account
# Find: aws ec2 describe-key-pairs --profile <profile>
AWS_KEY_NAME=your-ec2-key-pair-name

# Security Group ID(s) — comma-separated, no spaces
# Requirements:
#   - SSH (port 22) inbound from your engineer IP
#   - Self-referencing all-traffic inbound rule (source = same SG)
#     (AIO: not strictly needed for inter-node comms since it's one VM,
#      but recommended for consistency and future arch tests)
# Find: aws ec2 describe-security-groups --profile <profile>
AWS_SECURITY_GROUP_IDS=sg-xxxxxxxxxxxx

# 3 subnet IDs — all 3 required even though AIO only uses public-1a
# Mapped to aliases: public-1a, public-1b, public-1c (in order)
# Find default subnets:
#   aws ec2 describe-subnets --filters "Name=default-for-az,Values=true" \
#     --query 'Subnets[].{ID:SubnetId,AZ:AvailabilityZone}' --output table
AWS_SUBNET_IDS=subnet-aaa111111,subnet-bbb222222,subnet-ccc333333

# Which alias to use as the default subnet (default: public-1a)
AWS_DEFAULT_SUBNET=public-1a

# ── Instance Sizing (AIO — single VM, all services colocated) ─
# Only PLATFORM type is used for AIO. Use t3.xlarge — all services
# (IAP, IAG, MongoDB, Redis) compete for the same CPU/RAM.
AWS_INSTANCE_TYPE_PLATFORM=t3.xlarge
# AWS_INSTANCE_TYPE_REDIS=     # not used for AIO (no separate Redis VM)
# AWS_INSTANCE_TYPE_MONGODB=   # not used for AIO (no separate MongoDB VM)
# AWS_INSTANCE_TYPE_GATEWAY=   # not used for AIO (no separate Gateway VM)

# ── Legacy Themis only (DO NOT uncomment for current Themis main) ─
# Current Themis main already includes gateway VMs in base tfvars.
# Only set to true if you are targeting a legacy Themis branch (pre-2024).
# DEPLOY_GATEWAY_TFVARS=true
