# ==============================================================
# .env — /themis-aws-deploy  ·  HA2 Architecture
# ==============================================================
# 9 VMs: Redis Sentinel ×3, MongoDB ReplicaSet ×3, Platform ×2, Gateway ×1
# Build time: ~44 min  |  Est. cost: ~$0.80–1.00/hr
#
# USAGE:
#   cp sample-env/env.ha2.example .env
#   # Fill in all fields marked REQUIRED
#   # Then open run-vars.yml and set:  architecture: ha2
#   # Then invoke: /themis-aws-deploy
#
# HA2 SPECIFIC NOTES:
#   - Redis Sentinel: 3 nodes form a sentinel cluster. One acts as master;
#     sentinels elect a new master if the primary fails (port 26379).
#     Verify after build: redis-cli -h <redis01_ip> sentinel masters
#
#   - MongoDB ReplicaSet: 3 nodes (1 PRIMARY, 2 SECONDARY). Elections require
#     majority (2/3). Verify after build: mongo --eval "rs.status()"
#
#   - Platform: 2 nodes — both register to IAP cluster. Load is distributed
#     across both instances.
#
#   - Security Group: self-referencing all-traffic rule is MANDATORY.
#     Without it: MongoDB replica set elections will fail (27017 blocked),
#     Redis sentinel cluster won't form (26379 blocked), and Platform nodes
#     won't share state (3000 blocked).
#
#   - Subnets: place nodes across 3 AZs for true HA resiliency.
#     If your account only has 1 AZ, use the same subnet ID for all 3 —
#     HA will still work but won't survive an AZ outage.
# ==============================================================

# ── JFrog Identity Token (REQUIRED) ──────────────────────────
JFROG_TOKEN=

# ── GitLab Deploy Token (Required on first sync or after team update) ─
GITLAB_TOKEN=

# ── AWS Account (REQUIRED for non-pe-team-sbx accounts) ─────

AWS_REGION=us-east-1

# EC2 key pair name in the target account
AWS_KEY_NAME=your-ec2-key-pair-name

# Security Group — MANDATORY: must have self-referencing all-traffic inbound rule
# Without this, MongoDB replica set and Redis sentinel cluster will fail to form.
# Create self-referencing rule:
#   SG_ID=sg-xxxxxxxxxxxx
#   aws ec2 authorize-security-group-ingress \
#     --group-id $SG_ID \
#     --protocol all --port -1 \
#     --source-group $SG_ID \
#     --profile <profile>
AWS_SECURITY_GROUP_IDS=sg-xxxxxxxxxxxx

# 3 subnets — spread across AZs for true HA
# public-1a → AZ1 (e.g. us-east-1a)
# public-1b → AZ2 (e.g. us-east-1b)
# public-1c → AZ3 (e.g. us-east-1c)
# Find default subnets per AZ:
#   aws ec2 describe-subnets --filters "Name=default-for-az,Values=true" \
#     --query 'Subnets[].{ID:SubnetId,AZ:AvailabilityZone}' --output table
AWS_SUBNET_IDS=subnet-aaa111111,subnet-bbb222222,subnet-ccc333333
AWS_DEFAULT_SUBNET=public-1a

# ── Instance Sizing (HA2 — 9 VMs, production-capable) ─────────
# Platform nodes handle more traffic in HA — use t3.large
# MongoDB RS members: t3.medium is fine for test; use t3.large for write-heavy workloads
AWS_INSTANCE_TYPE_PLATFORM=t3.large     # Platform ×2 (HA load balanced)
AWS_INSTANCE_TYPE_REDIS=t3.medium       # Redis Sentinel ×3
AWS_INSTANCE_TYPE_MONGODB=t3.medium     # MongoDB ReplicaSet ×3 (increase to t3.large for write-heavy)
AWS_INSTANCE_TYPE_GATEWAY=t3.medium     # IAG Gateway ×1

# ── Legacy Themis only ────────────────────────────────────────
# DEPLOY_GATEWAY_TFVARS=true
