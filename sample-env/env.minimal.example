# ==============================================================
# .env — /themis-aws-deploy  ·  Minimal Architecture
# ==============================================================
# 4 VMs: Redis, MongoDB, Platform, Gateway — each on a dedicated instance
# Build time: ~57 min  |  Est. cost: ~$0.35–0.45/hr
#
# USAGE:
#   cp sample-env/env.minimal.example .env
#   # Fill in all fields marked REQUIRED
#   # Then open run-vars.yml and set:  architecture: minimal
#   # Then invoke: /themis-aws-deploy
#
# NOTES:
#   - All 4 VMs land in the public-1a subnet by default
#   - 3 subnet IDs are required in the subnet_map block even though Minimal
#     only places VMs in one AZ
#   - Security Group self-referencing rule is needed so MongoDB and Redis
#     can be reached from the Platform VM (they're on separate IPs now)
#   - First multi-VM architecture to test — validates inventory generation
#     and inter-node connectivity before attempting HA architectures
# ==============================================================

# ── JFrog Identity Token (REQUIRED) ──────────────────────────
JFROG_TOKEN=

# ── GitLab Deploy Token (Required on first sync or after team update) ─
GITLAB_TOKEN=

# ── AWS Account (REQUIRED for non-pe-team-sbx accounts) ─────

AWS_REGION=us-east-1

# EC2 key pair name in the target account
AWS_KEY_NAME=your-ec2-key-pair-name

# Security Group — comma-separated, no spaces
# Requirements:
#   - SSH (port 22) inbound from your engineer IP
#   - Self-referencing all-traffic inbound rule (source = same SG)
#     Needed so Platform VM can reach MongoDB (27017) and Redis (6379) VMs
AWS_SECURITY_GROUP_IDS=sg-xxxxxxxxxxxx

# 3 subnet IDs — Minimal places all 4 VMs in public-1a
# All 3 IDs must be present even when only public-1a is used
AWS_SUBNET_IDS=subnet-aaa111111,subnet-bbb222222,subnet-ccc333333
AWS_DEFAULT_SUBNET=public-1a

# ── Instance Sizing (Minimal — 4 dedicated VMs) ───────────────
# Separate VMs per role — right-size each independently
AWS_INSTANCE_TYPE_PLATFORM=t3.large     # IAP Platform VM (needs more RAM for Node.js workers)
AWS_INSTANCE_TYPE_REDIS=t3.medium       # Redis VM (standalone, no sentinel — light footprint)
AWS_INSTANCE_TYPE_MONGODB=t3.medium     # MongoDB VM (standalone, no replica set)
AWS_INSTANCE_TYPE_GATEWAY=t3.medium     # IAG Gateway VM

# ── Legacy Themis only ────────────────────────────────────────
# DEPLOY_GATEWAY_TFVARS=true
