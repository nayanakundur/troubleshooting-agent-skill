# ============================================================
# .env.example — copy to .env and fill in real values.
# .env is gitignored; this file is the shareable template.
#
# The comments below capture concrete failures hit during the
# first end-to-end AIO build via /themis-aws-deploy, so future
# builds (any architecture) don't lose time re-discovering them.
# ============================================================

PLATFORM_URL=https://customer.itential.io
AUTH_METHOD=oauth          # oauth | basic
CLIENT_ID=<client-id>
CLIENT_SECRET=<client-secret>
MONGO_URL=mongodb://<user>:<password>@<host>:27017/<db>    # optional — for direct DB diagnostics
REDIS_HOST=<redis-host>             # optional
SSH_HOST_1=<ssh-host>               # optional — multi-host SSH pattern
SSH_USER_1=<ssh-user>
SSH_KEY_PATH_1=<path-to-private-key>
SSH_ROLE_1=<iap|mongo|redis|gateway>

JIRA_API_TOKEN=<jira-api-token>     # for Jira MCP write operations
GITLAB_TOKEN=<gitlab-deploy-token>  # GitLab Deploy Token — pull platform-claude-skills (read_repository)

# JFrog Identity Token — pull platform RPMs from itential.jfrog.io.
# Generate: itential.jfrog.io -> User Profile -> Generate Identity Token.
# Used by: scripts/pull-platform-rpms.sh, deployer-inventory skill,
# /themis-aws-deploy (auto-populates repository_password + gateway .whl pull).
#
# GOTCHA: when hand-constructing platform_packages URLs (run-vars.yml), every
# repo except GATEWAY-MANAGER uses <REPO>/<Product Name>/<Product Version>/<file>.rpm.
# GATEWAY-MANAGER uniquely doubles its own name: GATEWAY-MANAGER/GATEWAY-MANAGER/<file>.rpm
# (single-segment form 404s). See CLAUDE.md's JFrog RPM Repository table and
# .claude/skills/themis-aws-deploy/LOCAL-EXTENSIONS.md for a working example URL.
JFROG_TOKEN=<jfrog-identity-token>

# ---- AWS (used by /themis-aws-deploy) ----
#
# GOTCHA: if the AWS CLI profile below uses static STS credentials
# (aws_access_key_id/aws_secret_access_key/aws_session_token in this .env,
# case-insensitive lookup) rather than SSO, that session WILL expire and has
# no automatic refresh path — re-provision it manually. Check freshness before
# a build with: aws sts get-caller-identity --profile <aws_profile>
# (an expired token fails as ExpiredToken, usually mid-build).
AWS_REGION=us-east-1       # AWS region (default: us-east-1 from Themis terraform.tfvars)
                           #   /themis-aws-deploy writes this to auto-account.tfvars
AWS_KEY_NAME=<ec2-key-pair-name>              # EC2 key pair name (non-pe-team-sbx accounts only)

# GOTCHA: re-verify these IDs still exist before EVERY run, not just the first
# time you set them up. Security groups and subnets can be deleted/rotated
# between sessions by other engineers or account cleanup, and this only
# surfaces as `InvalidGroup.NotFound` at `tofu plan` — after everything else
# has already been provisioned/spent time on.
AWS_SECURITY_GROUP_IDS=<sg-xxxxxxxx>    # comma-separated SG IDs; must allow SSH (22) inbound (non-pe-team-sbx only)
AWS_SUBNET_IDS=<subnet-xxxxxxxx>        # comma-separated subnet IDs — maps to public-1a/b/c aliases in subnet_map
AWS_DEFAULT_SUBNET=public-1a            # which public-1x alias to use as default_subnet (optional, default: public-1a)

AWS_INSTANCE_TYPE_PLATFORM=t3.medium    # instance type for platform nodes (e.g. t3.large); default: t3.medium
AWS_INSTANCE_TYPE_REDIS=t3.medium       # instance type for redis nodes; default: t3.medium
AWS_INSTANCE_TYPE_MONGODB=t3.medium     # instance type for mongo nodes; default: t3.medium
AWS_INSTANCE_TYPE_GATEWAY=t3.medium     # instance type for gateway nodes; default: t3.medium

DEPLOY_GATEWAY_TFVARS=false   # true = apply *-with-gateway.tfvars overrides (legacy Themis only)
                               #   Current Themis main already includes gateway VMs in base tfvars.

# ---- /deploy-containers (Docker / Kubernetes reproduction) ----
ECR_REGISTRY=497639811223.dkr.ecr.us-east-2.amazonaws.com  # Itential ECR (us-east-2); do not change
DEVSTACK_DIR=              # override ~/itential-dev-stack clone location (leave blank for default)
K8S_NAMESPACE=itential     # target K8s namespace for Helm deployments
K8S_CONTEXT=               # kubectl context name (leave blank to use current-context)

# ---- Local tooling gotchas (not .env keys, just flagging here since this is
#      the file engineers read before their first build) ----
#
# 1. OpenTofu on Apple Silicon: the PATH-resolved `tofu` binary may be x86_64
#    and run under Rosetta, causing `Error: timeout while waiting for plugin
#    to start` / `Error: Failed to load plugin schemas` at tofu plan/apply.
#    Verify with `file $(which tofu)` — must report arm64. If not, install/use
#    a native arm64 build (e.g. `brew reinstall opentofu` confirmed arm64).
#
# 2. apply_run_vars.py needs PyYAML. If missing on both Homebrew and system
#    Python, and Homebrew Python blocks a plain `pip install` (PEP 668 /
#    externally-managed-environment), use:
#    pip install --user --break-system-packages pyyaml
